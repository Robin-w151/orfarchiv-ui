{
  "name": "ui",
  "version": "5.0.0-next.21",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "generate:csp-script-hashes": "node scripts/generate-csp-script-hashes.js",
    "preview": "vite build && vite --host 0.0.0.0 preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
    "check:watch": "svelte-kit sync && concurrently -n svelte,sw \"svelte-check --tsconfig ./tsconfig.json --watch\" \"tsc -p src/service-worker --noEmit --watch --preserveWatchOutput\"",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write --plugin-search-dir=. .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "svelte-kit sync && storybook build",
    "storybook:smoke": "node scripts/storybook-smoke.js",
    "prepare": "husky && npx svelte-kit sync"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#common/*": "./src/lib/shared/common/src/*"
  },
  "dependencies": {
    "@mozilla/readability": "0.5.0",
    "@trpc/server": "11.22.1",
    "dompurify": "3.4.17",
    "effect": "4.1.1",
    "jsdom": "30.1.3",
    "lru-cache": "11.5.3",
    "luxon": "3.7.2",
    "mongodb": "7.8.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/vitest": "4.1.1",
    "@eslint/js": "10.0.1",
    "@katama-labs/vite-pwa-sveltekit": "2.0.0",
    "@panzoom/panzoom": "4.6.2",
    "@playwright/test": "1.64.1",
    "@semantic-release/git": "11.0.1",
    "@skeletonlabs/floating-ui-svelte": "0.3.9",
    "@steeze-ui/heroicons": "2.4.2",
    "@steeze-ui/svelte-icon": "1.6.2",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-links": "10.6.5",
    "@storybook/builder-vite": "10.6.5",
    "@storybook/sveltekit": "10.6.5",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@trpc/client": "11.22.1",
    "@types/dotenv-flow": "3.3.3",
    "@types/jsdom": "30.0.0",
    "@types/lodash.debounce": "4.0.9",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vueless/storybook-dark-mode": "10.0.8",
    "acorn": "8.19.0",
    "browserlist": "1.0.2",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "dexie": "4.4.7",
    "dotenv-flow": "4.1.0",
    "easy-speech": "2.4.0",
    "escodegen": "2.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "rxjs": "7.8.2",
    "semantic-release": "25.0.9",
    "sonda": "0.14.0",
    "storybook": "10.6.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "svelte-loader": "3.2.4",
    "svelte-persisted-store": "0.12.0",
    "svelte-portal": "2.2.1",
    "tailwindcss": "4.3.3",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "//": "overrides: remove the @vercel/analytics and @vercel/speed-insights entries once they declare @sveltejs/kit 3 as a peer",
  "overrides": {
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    },
    "@vercel/speed-insights": {
      "@sveltejs/kit": "$@sveltejs/kit"
    },
    "conventional-changelog-conventionalcommits": ">=10.0.0",
    "conventional-changelog-writer": ">=9.0.0",
    "glob": ">=10.5.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "baseline 2024"
  ],
  "packageManager": "npm@11.11.0"
}
